# Email Sender SaaS - Environment Variables
# Copy this file to .env and fill in your values
# This file is used by both client (frontend) and server (backend)

# ============================================================================
# Backend Environment Variables (Server-side only)
# ============================================================================

# Google OAuth Configuration (server-side)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
FRONTEND_URL=http://localhost:5173

# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/email-sender

# Redis Configuration
# Option 1: Use REDIS_URL (recommended for Upstash, Render, etc.)
# REDIS_URL=redis://default:password@host:port
# Option 2: Use individual settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================================================
# Frontend Environment Variables (Vite - prefixed with VITE_)
# These are exposed to the browser during build time
# ============================================================================

# Google OAuth Configuration (for frontend)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
VITE_API_URL=http://localhost:3001/api
